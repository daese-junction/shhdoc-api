# 배포 담당자용. 커밋하지 말 것.
#
# 위치 주의: docker compose 는 compose.yaml 옆, 즉 "레포 루트의 .env" 만 읽는다.
#   cp deploy/.env.example .env   ← 루트로 복사해서 채운다 (deploy/.env 는 안 읽힘)
#
# 지금 실제로 필요한 값은 JWT_SECRET 하나다.
# 아래 SPRING_DATASOURCE_* 는 compose.yaml 에 직접 박혀 있어 현재 쓰이지 않는다.
# 외부 DB로 옮길 때 compose.yaml 을 ${...} 로 바꾸고 여기서 주입할 것.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/shhdoc
SPRING_DATASOURCE_USERNAME=shhdoc
SPRING_DATASOURCE_PASSWORD=

# JWT 서명 키. `openssl rand -base64 48` 로 생성. HS256이라 32바이트 이상이어야 한다.
JWT_SECRET=
